<Window x:Class="DuplicatorFinder.App.Views.DeleteConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar exclusão"
        Height="220" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,12" TextWrapping="Wrap">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} arquivo(s) serão enviados para a Lixeira do Windows">
                        <Binding Path="FileCount"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock TextWrapping="Wrap">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}Isso vai liberar aproximadamente {0} de espaço em disco. Os arquivos podem ser restaurados a partir da Lixeira, se necessário.">
                        <Binding Path="TotalSizeDisplay"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick"/>
            <Button Content="Excluir" Width="90" IsDefault="True" FontWeight="Bold" Click="OnConfirmClick"/>
        </StackPanel>
    </Grid>
</Window>
