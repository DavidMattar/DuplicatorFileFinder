<UserControl x:Class="DuplicatorFinder.App.Views.ScanProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
            <TextBlock Text="{Binding Phase}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <ProgressBar Minimum="0" Maximum="100" Value="{Binding GlobalPercent, Mode=OneWay}" Height="24"/>
            <TextBlock Text="{Binding GlobalPercent, StringFormat='{}{0:0}%'}" HorizontalAlignment="Center" Margin="0,4,0,16"/>

            <TextBlock Text="{Binding CurrentFile}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

            <TextBlock HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} arquivo(s) processados · {1} grupo(s) encontrados">
                        <Binding Path="FilesScanned"/>
                        <Binding Path="GroupsFoundSoFar"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Button Content="Cancelar" Command="{Binding CancelCommand}" HorizontalAlignment="Center" Padding="16,8"/>
        </StackPanel>
    </Grid>
</UserControl>
