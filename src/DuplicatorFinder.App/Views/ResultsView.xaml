<UserControl x:Class="DuplicatorFinder.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DuplicatorFinder.App.ViewModels">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} arquivos escaneados">
                        <Binding Path="TotalFilesScanned"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} grupo(s) de duplicados — {1} recuperáveis">
                        <Binding Path="Groups.Count"/>
                        <Binding Path="TotalWastedBytes" Converter="{StaticResource BytesToHumanReadable}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <Button Content="Selecionar recomendados" Command="{Binding SelectRecommendedCommand}" Margin="0,0,8,0"/>
            <Button Content="Inverter seleção" Command="{Binding InvertSelectionCommand}" Margin="0,0,8,0"/>
            <Button Content="Novo escaneamento" Command="{Binding NewScanCommand}"/>
        </StackPanel>

        <ListBox Grid.Row="1"
                  ItemsSource="{Binding Groups}"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DuplicateGroupViewModel}">
                    <Border BorderBrush="LightGray" BorderThickness="1" Margin="0,0,0,8" Padding="8">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Margin="0,0,0,4">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} — {1} arquivo(s) — {2} recuperáveis">
                                        <Binding Path="Kind"/>
                                        <Binding Path="Files.Count"/>
                                        <Binding Path="WastedBytes" Converter="{StaticResource BytesToHumanReadable}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FileCandidateViewModel}">
                                        <Grid Margin="16,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsMarkedForDeletion}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Image Grid.Column="1" Source="{Binding FullPath, Converter={StaticResource FilePathToThumbnail}}"
                                                   Width="40" Height="40" Stretch="Uniform" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding FullPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding SizeBytes, Converter={StaticResource BytesToHumanReadable}}" Margin="8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Reason}" FontStyle="Italic" Foreground="Gray" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Excluir selecionados (enviar para Lixeira)" Command="{Binding DeleteSelectedCommand}" Padding="12,6" FontWeight="Bold"/>
            <TextBlock Text="{Binding StatusMessage}" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
