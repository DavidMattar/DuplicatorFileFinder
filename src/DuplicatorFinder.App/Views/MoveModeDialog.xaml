<Window x:Class="DuplicatorFinder.App.Views.MoveModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Como mover os arquivos selecionados?"
        Height="340" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Escolha o que fazer com o arquivo que sobrevive em cada grupo:"
                       FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <RadioButton GroupName="MoveMode" IsChecked="{Binding IsMoveEntireGroupSelected}" Margin="0,0,0,10">
                <TextBlock Text="Mover o grupo inteiro (arquivo mantido + cópias)" TextWrapping="Wrap"/>
            </RadioButton>

            <RadioButton GroupName="MoveMode" IsChecked="{Binding IsKeepHighestResolutionSelected}" Margin="0,0,0,16">
                <TextBlock Text="Manter o de maior resolução no lugar e mover todas as outras cópias" TextWrapping="Wrap"/>
            </RadioButton>

            <Border Background="#F3F3F3" BorderBrush="LightGray" BorderThickness="1" Padding="12">
                <TextBlock Text="{Binding ModeExplanation}" TextWrapping="Wrap" Foreground="#333333"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick"/>
            <Button Content="Continuar" Width="110" IsDefault="True" FontWeight="Bold" Click="OnConfirmClick"/>
        </StackPanel>
    </Grid>
</Window>
