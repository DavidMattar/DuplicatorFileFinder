<Application x:Class="DuplicatorFinder.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Sem StartupUri: a MainWindow é criada manualmente em App.xaml.cs (OnStartup), depois
        que o contêiner de injeção de dependência já está montado, para que ela (e seu
        MainViewModel) recebam todas as dependências pelo construtor.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
